# Copy to .env. Passwords and API keys belong in ignored files, not here.
TM_PUBLIC_ORIGIN=http://localhost:8090
TM_RETENTION_DAYS=7
TM_HOTSPOT_DNS=192.168.77.1
TM_DEVICE_HOST=fancontroller-r3-3-0667a0
TM_DEVICE_MAC=14:63:93:06:67:A0
TM_NVML_LIBRARY=/usr/lib/x86_64-linux-gnu/libnvidia-ml.so.1
# Optional comma-separated UUIDs. Empty monitors all visible NVIDIA GPUs; any failed reading triggers fallback.
TM_GPU_UUIDS=
TM_GPU_LABEL=NVIDIA P40
TM_UPPER_LABEL=Upper · air out
TM_LOWER_LABEL=Lower · air in
# Exactly four comma-separated channel labels.
TM_CHANNEL_LABELS=GPU fans · splitter,Unused,Unused,Cabinet fans · inlet / exhaust
# Set after commissioning to keep real hardware mode on subsequent `docker compose up` commands:
# COMPOSE_FILE=compose.yaml:compose.hardware.yaml
